{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!spec/examples/blocks/invalid",
      "!action/dist",
      "!experiments/closes-probe-2026-10/results.json",
      "!experiments/closes-probe-2026-10/reread-2026-10-12.json",
      "!experiments/checks-probe-2026-10/results.json",
      "!experiments/open-source-advisory-2026-10-study2/erratum-1/closers.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
