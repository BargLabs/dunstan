{
  "name": "dunstan",
  "version": "0.1.6",
  "mcpName": "io.github.BargLabs/dunstan",
  "description": "Holds a coding agent's completion report to the record: deterministic checks of a declared handback block against the repository's own metadata.",
  "license": "AGPL-3.0-only",
  "author": "Barg Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BargLabs/dunstan.git"
  },
  "homepage": "https://barglabs.ai/dunstan",
  "bugs": {
    "url": "https://github.com/BargLabs/dunstan/issues",
    "email": "team@barglabs.ai"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "coding-agents",
    "pull-requests",
    "github",
    "verification",
    "claude"
  ],
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "dunstan": "dist/dunstan.mjs"
  },
  "files": [
    "dist/dunstan.mjs",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES",
    "spec/LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dunstan-eval": "node dist/dunstan-eval.mjs",
    "build:hosted": "node --experimental-strip-types --no-warnings=ExperimentalWarning hosted/build/build.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "preflight": "bash scripts/preflight_fast.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "4.147.0",
    "zod": "^4.6.5"
  }
}
